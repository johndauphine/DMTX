<?xml version="1.0" ?>
<!--
  The dmtx account is deliberately least-privilege. ClickHouse is a
  rebuild-only target that Stage 4 refuses for upsert, incremental, and delete
  routes, so several tests assert those refusals. Granting broad access would
  let a refusal pass for the wrong reason - because the account could not do
  the thing anyway, rather than because the route declined it.

  The explicit system.* column grants are what discovery actually reads. They
  were recovered from a running fixture; widening them to GRANT SELECT ON
  system.* would hide a discovery path that asks for a column it was never
  granted.
-->
<clickhouse>
    <users>
        <dmtx replace="replace">
            <profile>default</profile>
            <networks>
                <ip>::/0</ip>
            </networks>
            <!-- Literal rather than from_env: setting CLICKHOUSE_PASSWORD
                 would change the default admin account instead, and the
                 entrypoint would then try to create databases as a user with
                 no grant to do so. Throwaway value; see env.sh. -->
            <password>dmtx_source_test</password>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT(engine, name, uuid) ON system.databases</query>
                <query>GRANT SELECT(value, name) ON system.merge_tree_settings</query>
                <query>GRANT SELECT(database, `table`) ON system.data_skipping_indices</query>
                <query>GRANT SELECT(database, name, is_temporary, engine, engine_full, partition_key, sorting_key, primary_key, sampling_key, storage_policy, comment, dependencies_database, dependencies_table, create_table_query, total_rows) ON system.tables</query>
                <query>GRANT SELECT(database, `table`, position, name, type, default_kind, default_expression, comment, is_in_partition_key, is_in_sorting_key, is_in_primary_key, is_in_sampling_key, compression_codec) ON system.columns</query>
                <query>GRANT ALL ON dmtx_stage4_live_default.*</query>
                <query>GRANT ALL ON dmtx_stage4_live_source.*</query>
                <query>GRANT ALL ON dmtx_stage4_live_target.*</query>
            </grants>
        </dmtx>
    </users>
</clickhouse>
